GROQ_API_KEY=
# SENTRY_DSN=          # optional: enables crash reporting (see sentry.io)
# Optional overrides
# HOTKEY=ctrl+space
# MODE=hold            # hold (press-hold-release) or tap (toggle on/off)
# WHISPER_MODEL=whisper-large-v3-turbo
# CLEANUP_MODEL=llama-3.3-70b-versatile   # "none" to disable cleanup
# LANGUAGE=en          # ISO-639-1, omit for auto-detect
# SAMPLE_RATE=16000
# LOCAL_ENGINE=false   # true = offline mode via faster-whisper (requirements-optional.txt)
# LOCAL_MODEL=small    # tiny.en | base.en | small | medium
# TOASTS=true
# TRAY=true